<%- include('partials/header') %>

<h1><%= category.name %></h1>
<% if (category.description) { %>
    <p><%= category.description %></p>
<% } %>

<h2>Service Projects in this Category</h2>
<% if (projects.length > 0) { %>
    <ul class="projects-list">
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                — <%= project.date_needed.toDateString ? project.date_needed.toDateString() : project.date_needed %>
            </li>
        <% }); %>
    </ul>
<% } else { %>
    <p>No projects currently listed in this category.</p>
<% } %>

<%- include('partials/footer') %>