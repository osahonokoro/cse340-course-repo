<%- include('partials/header') %>

<h1>Upcoming Service Projects</h1>

<% if (projects && projects.length > 0) { %>
    <ul class="projects-list">
        <% projects.forEach(project => { %>
            <li>
                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                <p><%= project.description %></p>
                <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                <p><strong>Date Needed:</strong> <%= project.date_needed %></p>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>No upcoming projects found.</p>
<% } %>

<%- include('partials/footer') %>