<%- include('partials/header') %>

<h1><%= project.title %></h1>

<div class="project-details">
    <p><%= project.description %></p>

    <p><strong>Date Needed:</strong> <%= project.date_needed %></p>
    <p><strong>Status:</strong> <%= project.status %></p>
    <p><strong>Location:</strong> <%= project.location %></p>

    <% if (project.categories && project.categories.length > 0) { %>
    <p><strong>Categories:</strong>
        <% project.categories.forEach((catName, index) => { %>
            <a href="/category/<%= project.category_ids[index] %>" class="category-tag"><%= catName %></a><% if (index < project.categories.length - 1) { %>, <% } %>
        <% }); %>
    </p>
    <% } %>

    <p><strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
    </p>

    <% if (isLoggedIn) { %>
        <% if (isUserVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Remove Myself as a Volunteer</button>
            </form>
        <% } else { %>
            <form action="/volunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Volunteer for this Project</button>
            </form>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Assign Categories</a></p>
    <% } %>
</div>

<%- include('partials/footer') %>