<%- include('partials/header') %>

<h1>Partner Organizations</h1>
<p>Here are a few of our partner organizations:</p>
<ul class="organizations-list">
    <% organizations.forEach(organization => { %>
        <li>
            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
            <a href="/organization/<%= organization.organization_id %>"><strong><%= organization.name %></strong></a>: <%= organization.contact_email %>
        </li>
    <% }) %>
</ul>

<%- include('partials/footer') %>