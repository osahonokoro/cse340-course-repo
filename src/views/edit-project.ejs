<%- include('partials/header') %>

<h1>Edit Project</h1>

<form action="/edit-project/<%= project.project_id %>" method="POST">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" value="<%= project.title %>" required>

    <label for="description">Description:</label>
    <textarea id="description" name="description" required><%= project.description %></textarea>

    <label for="location">Location:</label>
    <input type="text" id="location" name="location" value="<%= project.location %>" required>

    <label for="dateNeeded">Date Needed:</label>
    <input type="date" id="dateNeeded" name="dateNeeded" value="<%= project.date_needed.toISOString().split('T')[0] %>" required>

    <label for="status">Status:</label>
    <select id="status" name="status" required>
        <option value="active" <%= project.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="completed" <%= project.status === 'completed' ? 'selected' : '' %>>Completed</option>
        <option value="cancelled" <%= project.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
    </select>

    <label for="organizationId">Organization:</label>
    <select id="organizationId" name="organizationId" required>
        <% organizations.forEach(org => { %>
            <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                <%= org.name %>
            </option>
        <% }) %>
    </select>

    <button type="submit">Update Project</button>
</form>

<%- include('partials/footer') %>